<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/unlockGateStatusBar"
        style="@style/LumaStatusBarContainer"
        android:visibility="gone">

        <include layout="@layout/luma_status_bar_content" />

    </LinearLayout>

    <TextView
        android:id="@+id/unlockGateDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/publicsans_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textAlignment="center"
        android:textSize="24sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/unlockGateClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/publicsans_thin"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textAlignment="center"
        android:textSize="88sp" />

    <ImageView
        android:id="@+id/unlockGateHomeButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:clickable="true"
        android:contentDescription="@null"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_unlock_gate_lock" />

</FrameLayout>
