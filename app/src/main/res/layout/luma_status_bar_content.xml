<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/statusConnectivityLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start"
        android:baselineAligned="true"
        android:baselineAlignedChildIndex="0"
        android:orientation="horizontal"
        android:visibility="invisible">

        <TextView
            android:id="@+id/statusNetworkType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/public_sans"
            android:textColor="?attr/primaryColor"
            android:textSize="13sp"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/statusSignal"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:baselineAlignBottom="true"
            android:visibility="gone"
            android:src="@drawable/signal_4" />

        <ImageView
            android:id="@+id/statusWifi"
            android:layout_width="12dp"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"
            android:baselineAlignBottom="true"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:src="@drawable/wifi_full" />

        <ImageView
            android:id="@+id/statusBluetooth"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"
            android:baselineAlignBottom="true"
            android:visibility="gone"
            android:src="@drawable/bluetooth" />

    </LinearLayout>

    <app.luma.ui.BaselineFrameLayout
        android:id="@+id/statusClockLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <TextView
            android:id="@+id/statusClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/public_sans"
            android:textColor="?attr/primaryColor"
            android:textSize="19.4sp" />

    </app.luma.ui.BaselineFrameLayout>

    <LinearLayout
        android:id="@+id/statusBatteryLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:baselineAligned="true"
        android:baselineAlignedChildIndex="0"
        android:orientation="horizontal"
        android:visibility="invisible">

        <TextView
            android:id="@+id/statusBatteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/public_sans"
            android:textColor="?attr/primaryColor"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/statusBattery"
            android:layout_width="15dp"
            android:layout_height="10dp"
            android:baselineAlignBottom="true"
            android:scaleType="fitEnd"
            android:src="@drawable/battery_full" />

    </LinearLayout>

</merge>
